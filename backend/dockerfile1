# This stage builds the app which requires
# dev dependencies such as typescript, tsx etc.
# the final build wont require any of these dev dependencies, it
# only requires the built product, which usually sits
# inside dist folder. So we use a multi-stage build to reduce the final image size.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Next let us copy the build artifacts to a new image which will be the final image.
FROM node:20-alpine AS final
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist

# ensure that the user has permission to write to the /app directory
RUN chown -R node:node /app
USER node

# health check to ensure that the app is running
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s
  CMD curl -f http://localhost:3000/health || exit 1

# run the app
CMD ["node", "dist/index.js"]

